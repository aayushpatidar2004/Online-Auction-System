# AgriSmart Environment Configuration Example

# Django Secret Key (generate a strong key in production)
SECRET_KEY=django-insecure-agrismart-production-seed-key-change-in-prod-2026

# Debug mode (set False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Optional: defaults to SQLite if not provided)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agrismart_db

# MongoDB Configuration (Optional: articles & telemetry document storage)
# MONGODB_URI=mongodb://localhost:27017/agrismart_mongo

# OpenWeatherMap API Key (Free tier key from openweathermap.org)
# Leave blank or set to your key. System has an intelligent fallback weather engine.
OPENWEATHER_API_KEY=

# Frontend Application URL (for CORS)
FRONTEND_URL=http://localhost:5173

